#!/bin/bash
# RudramOS: before USBGuard first starts, trust the USB devices connected right now
# (internal keyboard, trackpad, webcam, Bluetooth, your keyboard and mouse on a desktop).
# Without this, USBGuard's "block everything unknown" would block them too.
set -euo pipefail

RULES=/etc/usbguard/rules.conf
if [[ -s "${RULES}" ]]; then
    exit 0
fi
tmp=$(mktemp)
usbguard generate-policy >"${tmp}"
install -m 0600 -o root -g root "${tmp}" "${RULES}"
rm -f "${tmp}"
echo "USBGuard: trusted $(grep -c '^allow' "${RULES}") connected device(s)"
