#!/bin/bash
# RudramOS app approval (Gatekeeper-style), docs/DESIGN.md §4.4. Uses fapolicyd.
# Programs in Downloads, Desktop, on USB drives or installed as user-level Flatpaks
# don't run until an admin approves them. Approval is pinned to the file's SHA-256.
#
#   status             is app approval on, and how many programs are approved
#   list               approved programs
#   approve <file>     allow this exact file to run (needs admin approval)
#   revoke <file>      remove an approval
#   on | off           turn app approval on or off
#   regenerate-rules   rebuild the per-user rules (runs at boot, before fapolicyd)

set -euo pipefail

# Testability overrides
RULES_DIR="${RULES_DIR:-/etc/fapolicyd/rules.d}"
TRUST_FILE="${TRUST_FILE:-/etc/fapolicyd/trust.d/pcos-approved}"
PASSWD_FILE="${PASSWD_FILE:-}"

die() {
    echo "$*" >&2
    exit 1
}

require_root() {
    # PCOS_TEST_ROOT lets tests/test-app-guard.sh run without root
    [[ "${EUID}" -eq 0 || "${PCOS_TEST_ROOT:-}" == 1 ]] || die "Run with sudo: sudo $(basename "$0") $*"
}

passwd_entries() {
    if [[ -n "${PASSWD_FILE}" ]]; then cat "${PASSWD_FILE}"; else getent passwd; fi
}

# XDG user dir (e.g. Downloads) for a home, honouring ~/.config/user-dirs.dirs
user_dir() {
    local home="$1" key="$2" fallback="$3" value
    value=$(sed -n "s/^${key}=\"\(.*\)\"$/\1/p" "${home}/.config/user-dirs.dirs" 2>/dev/null | head -n1)
    value="${value//\$HOME/${home}}"
    if [[ -z "${value}" || "${value}" == "${home}" || "${value}" == "${home}/" ]]; then
        value="${home}/${fallback}"
    fi
    echo "${value%/}"
}

regenerate_rules() {
    local out="${RULES_DIR}/50-pcos-users.rules" tmp
    tmp=$(mktemp)
    echo "# Generated by pcos-app-guard regenerate-rules: don't edit" >"${tmp}"
    while IFS=: read -r name _ uid _ _ home shell; do
        (( uid >= 1000 && uid < 60000 )) || continue
        [[ "${shell}" == */nologin || "${shell}" == */false ]] && continue
        [[ -n "${home}" ]] || continue
        local homes=("${home}") real
        real=$(realpath -m "${home}")
        [[ "${real}" != "${home}" ]] && homes+=("${real}")
        echo "# ${name}" >>"${tmp}"
        for h in "${homes[@]}"; do
            for d in "$(user_dir "${h}" XDG_DOWNLOAD_DIR Downloads)" "$(user_dir "${h}" XDG_DESKTOP_DIR Desktop)" "${h}/.local/share/flatpak"; do
                echo "deny_syslog perm=execute all : dir=${d}/" >>"${tmp}"
            done
        done
    done < <(passwd_entries)
    mkdir -p "${RULES_DIR}"
    install -m 0644 "${tmp}" "${out}"
    rm -f "${tmp}"
}

approved_paths() {
    [[ -r "${TRUST_FILE}" ]] || return 0
    # trust file lines: <path> <size> <sha256>
    awk 'NF >= 3 && $1 !~ /^#/ { $NF = ""; $(NF - 1) = ""; sub(/[ \t]+$/, ""); print }' "${TRUST_FILE}"
}

cmd="${1:-status}"
shift || true
case "${cmd}" in
status)
    state=$(systemctl is-active fapolicyd 2>/dev/null || true)
    echo "App approval: $([[ "${state}" == active ]] && echo on || echo "off (${state:-unknown})")"
    echo "Approved programs: $(approved_paths | grep -c . || true)"
    ;;
list) approved_paths ;;
approve)
    require_root "${cmd}"
    [[ $# -eq 1 ]] || die "usage: $(basename "$0") approve <file>"
    file=$(realpath -e -- "$1" 2>/dev/null) || die "No such file: $1"
    [[ -f "${file}" ]] || die "Not a regular file: ${file}"
    if approved_paths | grep -qxF -- "${file}"; then
        fapolicyd-cli --file update "${file}" --trust-file "$(basename "${TRUST_FILE}")"
    else
        fapolicyd-cli --file add "${file}" --trust-file "$(basename "${TRUST_FILE}")"
    fi
    fapolicyd-cli --update
    echo "Approved: ${file}"
    echo "If the file changes (e.g. an update replaces it), it needs approving again."
    ;;
revoke)
    require_root "${cmd}"
    [[ $# -eq 1 ]] || die "usage: $(basename "$0") revoke <file>"
    file=$(realpath -m -- "$1")
    approved_paths | grep -qxF -- "${file}" || die "Not approved: ${file}"
    fapolicyd-cli --file delete "${file}" --trust-file "$(basename "${TRUST_FILE}")"
    fapolicyd-cli --update
    echo "Approval removed: ${file}"
    ;;
on)
    require_root "${cmd}"
    regenerate_rules
    systemctl enable --now fapolicyd
    systemctl restart fapolicyd
    echo "App approval is on."
    ;;
off)
    require_root "${cmd}"
    systemctl disable --now fapolicyd
    echo "App approval is off: programs from Downloads, Desktop and USB drives run without approval."
    ;;
regenerate-rules)
    require_root "${cmd}"
    regenerate_rules
    ;;
-h | --help | help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "Unknown command: ${cmd}. See: $(basename "$0") --help" ;;
esac
