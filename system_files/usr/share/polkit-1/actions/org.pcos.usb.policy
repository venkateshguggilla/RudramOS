<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RudramOS</vendor>

  <!-- Allowing a USB device or changing USB protection: always needs admin approval
       (password, or password + security key in Strong mode). -->
  <action id="org.pcos.usb">
    <description>Allow a USB device</description>
    <message>Authentication is required to allow this USB device</message>
    <icon_name>drive-removable-media</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pcos-usb</annotate>
  </action>
</policyconfig>
