<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RudramOS</vendor>

  <!-- Updates page: install the newest signed RudramOS, or go back to the previous version.
       Admin password (or password + key in Strong mode), remembered for a few minutes. -->
  <action id="org.pcos.update">
    <description>Install RudramOS updates</description>
    <message>RudramOS Control Center wants to update RudramOS or go back to the previous version ($(cmdline_short))</message>
    <icon_name>software-update-available</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/pcos/pcos-update</annotate>
  </action>

  <!-- System page: switch the boot menu theme on or off (writes /boot/grub2) -->
  <action id="org.pcos.boot-menu">
    <description>Change the boot menu theme</description>
    <message>RudramOS Control Center wants to change the boot menu ($(cmdline_short))</message>
    <icon_name>computer</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/pcos/pcos-grub-theme</annotate>
  </action>
</policyconfig>
