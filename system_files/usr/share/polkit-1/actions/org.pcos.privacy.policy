<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RudramOS</vendor>

  <!-- Privacy settings and the VPN kill switch: admin approval (password, or password +
       security key in Strong mode). -->
  <action id="org.pcos.privacy">
    <description>Change privacy settings</description>
    <message>Authentication is required to change privacy settings</message>
    <icon_name>preferences-system-privacy</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pcos-privacy</annotate>
  </action>

  <action id="org.pcos.killswitch">
    <description>Turn the VPN kill switch on or off</description>
    <message>Authentication is required to change the VPN kill switch</message>
    <icon_name>network-vpn</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pcos-killswitch</annotate>
  </action>
</policyconfig>
