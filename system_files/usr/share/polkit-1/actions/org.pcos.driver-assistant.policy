<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RudramOS</vendor>

  <!-- Driver Assistant: switch to the image variant with the right graphics driver.
       Always needs admin approval (password, or password + security key in Strong mode). -->
  <action id="org.pcos.driver-assistant.switch">
    <description>Install graphics driver</description>
    <message>Authentication is required to install the graphics driver for this PC</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/pcos/pcos-gpu-switch</annotate>
  </action>
</policyconfig>
