#%PAM-1.0
# RudramOS admin approval: STRONG mode (your password + touching a registered FIDO2 security key).
# Managed by pcos-admin-mode. sudo and polkit (desktop password prompts) include this file.
# "substack" keeps system-auth's "sufficient" password success from ending the stack early,
# so the key check below always runs.
auth       substack     system-auth
auth       required     pam_u2f.so authfile=/etc/u2f_mappings cue [cue_prompt=Touch your security key] origin=pam://pcos appid=pam://pcos
