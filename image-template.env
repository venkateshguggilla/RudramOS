# Build parameters for the RudramOS image (read by the Justfile and CI)

# Output image name. The image is published as ghcr.io/<REPO_ORGANIZATION>/<IMAGE_NAME>
IMAGE_NAME=rudramos

# GitHub account that owns the repository and the container registry
REPO_ORGANIZATION="venkateshguggilla"

IMAGE_DESC="RudramOS: a secure, Mac-like personal desktop OS built on Fedora bootc"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,gnome,secure"

# Logo shown on artifacthub.io: the RudramOS trishul
IMAGE_LOGO_URL="https://raw.githubusercontent.com/venkateshguggilla/RudramOS/main/system_files/usr/share/icons/hicolor/256x256/apps/rudramos-logo.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
