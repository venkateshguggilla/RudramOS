# Build parameters for the PC OS image (read by the Justfile and CI)

# Output image name. The image is published as ghcr.io/<REPO_ORGANIZATION>/<IMAGE_NAME>
IMAGE_NAME=pcos

# GitHub account that owns the repository and the container registry
REPO_ORGANIZATION="venkateshguggilla"

IMAGE_DESC="PC OS: a secure, Mac-like personal desktop OS built on Fedora bootc"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,gnome,secure"

# Logo shown on artifacthub.io (placeholder until PC OS has its own logo)
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
